use rule bgzip from snv_indels as reference_rules_snv_indels_bgzip with:
    input:
        vcf="{file}.vcf",
    output:
        gz=temp("{file}.vcf.gz"),
    params:
        extra=config.get("bgzip", {}).get("extra", ""),
    log:
        "{file}.vcf.gz.log",
    benchmark:
        repeat(
            "{file}.vcf.gz.benchmark.tsv",
            config.get("bgzip", {}).get("benchmark_repeats", 1),
        )
    wildcard_constraints:
        file="(references)\/.*",


module references:
    snakefile:
        github(
            repo="hydra-genetics/references",
            path="workflow/Snakefile",
            tag="v1.0.1",
        )
    config:
        config


use rule * from references exclude all, create_background_file, create_artifact_file as references_*


