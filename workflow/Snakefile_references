include: "rules/common_references.smk"
include: "rules/references_rules.smk"


rule all:
    input:
        compile_output_file_list,


module pipeline:
    snakefile:
        "Snakefile"
    config:
        config


use rule * from pipeline exclude all


use rule vardict from snv_indels as reference_rules_snv_indels_vardict_gvcf with:
    input:
        reference=config.get("reference", {}).get("fasta", ""),
        bam="alignment/dorado_align/{experiment}_{sample}_{type}_reads.ont_adapt_trim.filtered.aligned.sorted.soft-clipped.bam",
        bai="alignment/dorado_align/{experiment}_{sample}_{type}_reads.ont_adapt_trim.filtered.aligned.sorted.soft-clipped.bam.bai",
        regions=config.get("vardict", {}).get("bed_file", os.path.join(config.get("bed_files"), "amplicons-background.bed")),
    output:
        vcf=temp(
            "references/vardict/{experiment}_{sample}_{type}_reads.ont_adapt_trim.filtered.aligned.sorted.soft-clipped.vardict.g.vcf"
        ),
    params:
        extra=config.get("reference_rules_snv_indels_vardict_gvcf", {}).get("extra", "-p -Q 1"),  # -p to output gVCF with all positions
        bed_columns=config.get("reference_rules_snv_indels_vardict_gvcf", {}).get("bed_columns", "-c 1 -S 2 -E 3 -g 4"),
        allele_frequency_threshold=config.get("reference_rules_snv_indels_vardict_gvcf", {}).get("allele_frequency_threshold", "0.01"),
        sample_name=lambda wildcards: f"{wildcards.sample}",
    log:
        "references/vardict/{experiment}_{sample}_{type}.vcf.log",
    benchmark:
        repeat(
            "references/vardict/{experiment}_{sample}_{type}.benchmark.tsv", config.get("reference_rules_snv_indels_vardict_gvcf", {}).get("benchmark_repeats", 1)
        )


use rule bgzip from snv_indels as reference_rules_snv_indels_bgzip with:
    input:
        vcf="{file}.vcf",
    output:
        gz=temp("{file}.vcf.gz"),
    params:
        extra=config.get("bgzip", {}).get("extra", ""),
    log:
        "{file}.vcf.gz.log",
    benchmark:
        repeat(
            "{file}.vcf.gz.benchmark.tsv",
            config.get("bgzip", {}).get("benchmark_repeats", 1),
        )
    wildcard_constraints:
        file="(references\/vardict\/).*",


module references:
    snakefile:
        github(
            repo="hydra-genetics/references",
            path="workflow/Snakefile",
            tag="v1.0.1",
        )
    config:
        config


use rule * from references exclude all, create_background_file as references_*


